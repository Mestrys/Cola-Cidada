# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Dashboard: https://supabase.com/dashboard → Project Settings → API

# URL do projeto Supabase (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Chave anônima (anon / public) — segura para o browser, protegida por RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chave service_role — NUNCA exponha no client. Apenas server-side (Route Handlers, scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
